APP_NAME=Laravel
AI_COMPATIBLE_BASE_URLS=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jw_ecommerce
DB_USERNAME=root
DB_PASSWORD=

# Optional local demo owner: set both values before php artisan migrate --seed.
DEMO_OWNER_NAME="JW Studio Owner"
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# Platform-owned EasyParcel OAuth app. Merchant tokens and pickup sender profiles remain encrypted in MySQL.
EASYPARCEL_OPERATING_ENVIRONMENT=sandbox
EASYPARCEL_OAUTH_CLIENT_ID=
EASYPARCEL_OAUTH_CLIENT_SECRET=
EASYPARCEL_PRODUCTION_AUTHORIZATION_ENABLED=false
EASYPARCEL_WEBHOOK_PATH_TOKEN=
EASYPARCEL_RECONCILIATION_STALE_QUEUE_SECONDS=120
EASYPARCEL_AWB_ALERT_AFTER_MINUTES=60
EASYPARCEL_AWB_REVIEW_AFTER_MINUTES=10
EASYPARCEL_CRON_LOCK_SECONDS=180

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Notification delivery uses the durable default database queue. Run a worker; do not use sync in an operational environment.
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Non-delivering local default. Configure production SMTP only behind the authorized release gate.
MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_LOG_CHANNEL=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Marketplace application configuration: server-only, disabled until platform acceptance.
MARKETPLACE_OAUTH_ACCEPTANCE_ENABLED=false
MARKETPLACE_HUB_URL=https://marketplace.jwaistudio.online
MARKETPLACE_HUB_OAUTH_ROUTING_ENABLED=false
MARKETPLACE_HUB_SHOPEE_SANDBOX_OAUTH_ENABLED=false
MARKETPLACE_HUB_SHOPEE_PRODUCTION_OAUTH_ENABLED=false
MARKETPLACE_HUB_LAZADA_PRODUCTION_OAUTH_ENABLED=false
MARKETPLACE_HUB_STORE_REPORTING_ENABLED=false
MARKETPLACE_HUB_REFRESH_ENDPOINT_ENABLED=false
MARKETPLACE_HUB_ACTIVITY_REPORTING_ENABLED=false
MARKETPLACE_HUB_EVENT_ENDPOINT_ENABLED=false
MARKETPLACE_HUB_VERIFICATION_ENDPOINT_ENABLED=false
MARKETPLACE_HUB_CLIENT_ID=
MARKETPLACE_HUB_CLIENT_SECRET=
MARKETPLACE_BASIC_WMS_ENABLED=false
MARKETPLACE_BASIC_WMS_UI_ENABLED=false
MARKETPLACE_ADVANCED_WMS_ENABLED=false
MARKETPLACE_SANDBOX_STOCK_WRITES_ENABLED=false
MARKETPLACE_STOCK_SYNC_OPERATIONS_ENABLED=false
MARKETPLACE_SHOPEE_STOCK_SYNC_ENABLED=false
MARKETPLACE_LAZADA_STOCK_SYNC_ENABLED=false
# Minimum gap between Lazada stock writes and exact readbacks for one store.
MARKETPLACE_LAZADA_STOCK_CALL_INTERVAL_MS=1100
MARKETPLACE_SHOPEE_STOCK_CALL_INTERVAL_MS=1000
MARKETPLACE_STOCK_SYNC_CANARY_ENFORCED=true
# Comma-separated persisted identities: platform:store_id:listing_variant_id
MARKETPLACE_STOCK_SYNC_CANARY_IDENTITIES=
MARKETPLACE_SHOPEE_TEST_STORE_ID=
MARKETPLACE_SHOPEE_SANDBOX_PARTNER_ID=
MARKETPLACE_SHOPEE_SANDBOX_PARTNER_KEY=
MARKETPLACE_LAZADA_ONLINE_TEST_ACCESS_ENABLED=false
MARKETPLACE_LAZADA_TEST_STORE_ID=
MARKETPLACE_WAREHOUSE_TRANSFERS_ENABLED=false
MARKETPLACE_MULTIWAREHOUSE_DISCOVERY_ENABLED=false
MARKETPLACE_MULTIWAREHOUSE_BINDING_ENABLED=false
MARKETPLACE_MULTIWAREHOUSE_MIGRATION_ENABLED=false
MARKETPLACE_MULTIWAREHOUSE_OPERATIONS_ENABLED=false
MARKETPLACE_MULTIWAREHOUSE_TEST_ACCEPTANCE_ENABLED=false
MARKETPLACE_MULTIWAREHOUSE_STOCK_SYNC_ENABLED=false
MARKETPLACE_MULTIWAREHOUSE_ORDERS_ENABLED=false
INVENTORY_CURRENT_STOCK_ONLY=false
MARKETPLACE_OPERATIONS_ENABLED=false
MARKETPLACE_READ_OPERATIONS_ENABLED=false
MARKETPLACE_IMPORT_OPERATIONS_ENABLED=false
MARKETPLACE_SHOPEE_ENABLED=false
MARKETPLACE_SHOPEE_MAIN_ACCOUNT_ENABLED=false
MARKETPLACE_SHOPEE_ENVIRONMENT=sandbox
MARKETPLACE_SHOPEE_PARTNER_ID=
MARKETPLACE_SHOPEE_PARTNER_KEY=
# Exact registered HTTPS URL ending /admin/marketplace/shopee/callback (no query/fragment).
MARKETPLACE_SHOPEE_CALLBACK_URL=
MARKETPLACE_SHOPEE_SANDBOX_CALLBACK_URL=
MARKETPLACE_SHOPEE_PRODUCTION_CALLBACK_URL=

# Messenger: configure Meta Page callback to https://ecom.jwaistudio.online/webhooks/facebook/messenger.
# Enable only after the challenge and signed POST succeed and messages v25.0 is subscribed.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_INBOUND_ROUTING_READY=false
