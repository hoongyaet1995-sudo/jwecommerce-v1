APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jw_ecommerce
DB_USERNAME=root
DB_PASSWORD=

# Optional local demo owner: set both values before php artisan migrate --seed.
DEMO_OWNER_NAME="JW Studio Owner"
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# Platform-owned EasyParcel OAuth app. Merchant tokens and pickup sender profiles remain encrypted in MySQL.
EASYPARCEL_OPERATING_ENVIRONMENT=sandbox
EASYPARCEL_OAUTH_CLIENT_ID=
EASYPARCEL_OAUTH_CLIENT_SECRET=
EASYPARCEL_PRODUCTION_AUTHORIZATION_ENABLED=false
EASYPARCEL_WEBHOOK_PATH_TOKEN=
EASYPARCEL_RECONCILIATION_STALE_QUEUE_SECONDS=120
EASYPARCEL_AWB_ALERT_AFTER_MINUTES=60
EASYPARCEL_AWB_REVIEW_AFTER_MINUTES=10
EASYPARCEL_CRON_LOCK_SECONDS=180

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Notification delivery uses the durable default database queue. Run a worker; do not use sync in an operational environment.
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Safe local default. Task 9 browser acceptance overrides this per process with MAIL_MAILER=array.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_LOG_CHANNEL=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
