          "id": "sec-bb026b79-5175-4b18-a164-b10a2da7f5db-faq-0",
          "title": "Which payment methods can I use?",
          "description": "Available methods are shown at checkout for your order. They may vary by currency, delivery address and provider requirements."
        },
        {
          "id": "sec-bb026b79-5175-4b18-a164-b10a2da7f5db-faq-1",
          "title": "What if my payment does not go through?",
          "description": "Check your order status before retrying. If you are unsure whether payment completed, contact our team with your order reference."
        },
        {
          "id": "sec-bb026b79-5175-4b18-a164-b10a2da7f5db-faq-2",
          "title": "Can I pay in instalments?",
          "description": "If an instalment option appears at checkout, review the provider’s eligibility requirements, repayment schedule and terms before continuing."
        },
        {
          "id": "sec-bb026b79-5175-4b18-a164-b10a2da7f5db-faq-3",
          "title": "How can I confirm my payment?",
          "description": "Check your order status. If you need help reconciling a payment, contact our team with your order reference and the payment reference. Never share passwords or card security codes."
        }
      ]
