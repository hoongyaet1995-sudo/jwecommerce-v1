{
  "version": 1,
  "document": {
    "type": "object",
    "allowUnknownFields": false,
    "fields": {
      "title": { "$ref": "title" },
      "slug": { "$ref": "slug" },
      "description": { "$ref": "description" },
      "template": { "$ref": "template" },
      "heroImage": { "$ref": "heroImage" },
      "seoTitle": { "$ref": "seoTitle" },
      "seoDescription": { "$ref": "seoDescription" },
      "sections": { "type": "array", "required": true, "items": { "$ref": "section" } }
    }
  },
  "definitions": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "string", "required": true },
    "description": { "type": "string" },
    "template": { "type": "string", "required": true, "enum": ["standard", "fullwidth", "landing"] },
    "heroImage": { "types": ["string", "null"], "format": "managed_or_external_url" },
    "seoTitle": { "type": "string" },
    "seoDescription": { "type": "string" },
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "hero_banner", "hero_slider", "split_hero", "announcement_bar", "media_text_split", "rich_text",
        "timeline_story", "stats_counter", "product_grid", "product_listing", "collection_tabs", "featured_deal", "pricing_table",
        "media_gallery", "video_embed", "before_after", "instagram_feed", "feature_cards", "icon_list",
        "comparison_matrix", "faq_accordion", "contact_form", "store_locator", "testimonials_slider", "logo_cloud",
        "cta_strip", "newsletter_signup"
      ]
    },
    "isVisible": { "type": "boolean" },
    "motionPreset": { "type": "string", "enum": ["subtle-lift", "fade-in", "smooth-zoom", "dynamic-pop", "none"] },
    "subtitle": { "type": "string" },
    "content": { "type": "string" },
    "mediaUrl": { "type": "string", "format": "managed_or_external_url" },
    "mediaType": { "type": "string", "enum": ["image", "video"] },
    "buttonText": { "type": "string" },
    "buttonLink": { "type": "string" },
    "secondaryButtonText": { "type": "string" },
    "secondaryButtonLink": { "type": "string" },
    "textAlignment": { "type": "string", "enum": ["left", "center", "right"] },
    "backgroundColor": { "type": "string" },
    "textColor": { "type": "string", "enum": ["light", "dark"] },
    "paddingY": { "type": "string", "enum": ["compact", "normal", "spacious"] },
    "overlayOpacity": { "type": "number" },
    "customColors": { "$ref": "sectionColorConfig" },
    "items": { "type": "array", "items": { "$ref": "sectionItem" } },
    "sliderInterval": { "type": "number" },
    "sliderAutoplay": { "type": "boolean" },
    "sliderHeight": { "type": "string", "enum": ["compact", "normal", "spacious", "fullscreen"] },
    "dealBadge": { "type": "string" },
    "cardBadge": { "type": "string" },
    "cardTitle": { "type": "string" },
    "cardSubtitle": { "type": "string" },
    "cardPrice": { "types": ["string", "number"] },
    "cardExtra": { "type": "string" },
    "tickerSpeed": { "type": "string", "enum": ["slow", "normal", "fast"] },
    "mediaPosition": { "type": "string", "enum": ["left", "right"] },
    "mediaAspectRatio": { "type": "string", "enum": ["16:9", "4:3", "1:1", "auto"] },
    "quote": { "type": "string" },
    "authorName": { "type": "string" },
    "authorRole": { "type": "string" },
    "authorAvatar": { "type": "string", "format": "managed_or_external_url" },
    "columnsCount": { "type": "integer", "enum": [2, 3, 4, 5, 6] },
    "productIds": { "type": "array", "items": { "type": "string" } },
    "sourceType": { "type": "string", "enum": ["category", "collection"] },
    "sourceId": { "type": "string" },
    "productLimit": { "type": "integer", "enum": [3, 4, 6, 8, 12] },
    "autoSlide": { "type": "boolean" },
    "autoSlideInterval": { "type": "number", "enum": [3, 3.5, 5, 7] },
    "showNavArrows": { "type": "boolean" },
    "tabCategories": { "type": "array", "items": { "type": "string" } },
    "tabs": { "type": "array", "items": { "$ref": "collectionTab" } },
    "dealEndDate": { "type": "string" },
    "discountPercent": { "type": "number" },
    "videoEmbedUrl": { "type": "string", "format": "managed_or_external_url" },
    "beforeImageUrl": { "type": "string", "format": "managed_or_external_url" },
    "afterImageUrl": { "type": "string", "format": "managed_or_external_url" },
    "beforeLabel": { "type": "string" },
    "afterLabel": { "type": "string" },
    "comparisonDimensionName": { "type": "string" },
    "comparisonOurBrandName": { "type": "string" },
    "comparisonCompetitorName": { "type": "string" },
    "formEmail": { "type": "string" },
    "contactPhone": { "type": "string" },
    "contactAddress": { "type": "string" },
    "contactButtonText": { "type": "string" },
    "formSuccessMessage": { "type": "string" },
    "subjectPlaceholder": { "type": "string" },
    "categoryPlaceholder": { "type": "string" },
    "messagePlaceholder": { "type": "string" },
    "inquiryCategories": { "type": "array", "items": { "$ref": "inquiryCategory" } },
    "newsletterCouponId": { "type": "string" },
    "section": { "type": "object" },
    "sectionColorConfig": {
      "type": "object",
      "allowUnknownFields": false,
      "defaults": {
        "eyebrowColor": "#818cf8",
        "titleColor": "#ffffff",
        "contentColor": "#d4d4d8",
        "primaryBtnBg": "#4f46e5",
        "primaryBtnText": "#ffffff",
        "secondaryBtnBg": "rgba(255, 255, 255, 0.1)",
        "secondaryBtnText": "#ffffff",
        "customBgColor": ""
      },
      "fields": {
        "eyebrowColor": { "type": "string" },
        "titleColor": { "type": "string" },
        "contentColor": { "type": "string" },
        "primaryBtnBg": { "type": "string" },
        "primaryBtnText": { "type": "string" },
        "secondaryBtnBg": { "type": "string" },
        "secondaryBtnText": { "type": "string" },
        "customBgColor": { "type": "string" }
      }
    },
    "sectionItem": {
      "type": "object",
      "allowUnknownFields": false,
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "imageUrl": { "type": "string", "format": "managed_or_external_url" },
        "videoUrl": { "type": "string", "format": "managed_or_external_url" },
        "linkUrl": { "type": "string" },
        "badge": { "type": "string" },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "rating": { "type": "number" },
        "author": { "type": "string" },
        "authorRole": { "type": "string" },
        "authorAvatar": { "type": "string", "format": "managed_or_external_url" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "value": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "isHighlighted": { "type": "boolean" },
        "handle": { "type": "string" },
        "metricLabel": { "type": "string" },
        "buttonText": { "type": "string" },
        "secondaryButtonText": { "type": "string" },
        "secondaryButtonLink": { "type": "string" }
      }
    },
    "collectionTab": {
      "type": "object",
      "allowUnknownFields": false,
      "fields": {
        "id": { "type": "string", "required": true },
        "label": { "type": "string", "required": true },
        "sourceType": { "type": "string", "required": true, "enum": ["category", "collection"] },
        "sourceId": { "type": "string", "required": true },
        "productLimit": { "type": "integer", "required": true, "enum": [3, 4, 6, 8] }
      }
    },
    "inquiryCategory": {
      "type": "object",
      "allowUnknownFields": false,
      "fields": {
        "id": { "type": "string", "required": true },
        "label": { "type": "string", "required": true }
      }
    }
  },
  "section": {
    "commonFields": ["id", "type", "title", "isVisible"],
    "sectionTypes": {
      "hero_banner": { "fields": ["motionPreset", "subtitle", "content", "mediaUrl", "mediaType", "buttonText", "buttonLink", "secondaryButtonText", "secondaryButtonLink", "textAlignment", "backgroundColor", "textColor", "paddingY", "overlayOpacity", "customColors", "items"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "hero_slider": { "fields": ["motionPreset", "subtitle", "content", "buttonText", "buttonLink", "secondaryButtonText", "secondaryButtonLink", "textAlignment", "backgroundColor", "textColor", "paddingY", "overlayOpacity", "sliderInterval", "sliderAutoplay", "sliderHeight", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "split_hero": { "fields": ["motionPreset", "subtitle", "content", "mediaUrl", "mediaType", "buttonText", "buttonLink", "secondaryButtonText", "secondaryButtonLink", "textAlignment", "backgroundColor", "textColor", "paddingY", "dealBadge", "cardBadge", "cardTitle", "cardSubtitle", "cardPrice", "cardExtra", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "announcement_bar": { "fields": ["motionPreset", "subtitle", "content", "tickerSpeed", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "media_text_split": { "fields": ["motionPreset", "subtitle", "content", "mediaUrl", "mediaType", "mediaPosition", "mediaAspectRatio", "buttonText", "buttonLink", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "rich_text": { "fields": ["motionPreset", "subtitle", "content", "quote", "authorName", "authorRole", "authorAvatar", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "timeline_story": { "fields": ["motionPreset", "subtitle", "content", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "stats_counter": { "fields": ["motionPreset", "subtitle", "content", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "product_grid": { "fields": ["motionPreset", "subtitle", "content", "productIds", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [{ "field": "productIds", "fact": "productIds.valid" }] },
      "product_listing": { "fields": ["motionPreset", "subtitle", "content", "sourceType", "sourceId", "productLimit", "autoSlide", "autoSlideInterval", "showNavArrows", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title", "sourceType", "sourceId"], "renderer": { "capable": true }, "runtimeRequirements": [{ "field": "sourceId", "fact": "listing.sourceId.valid" }] },
      "collection_tabs": { "fields": ["motionPreset", "subtitle", "content", "tabCategories", "tabs", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [{ "field": "tabs.*.sourceId", "fact": "tabs.*.sourceId.valid" }] },
      "featured_deal": { "fields": ["motionPreset", "subtitle", "content", "mediaUrl", "mediaType", "dealEndDate", "discountPercent", "dealBadge", "buttonText", "buttonLink", "secondaryButtonText", "secondaryButtonLink", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "pricing_table": { "fields": ["motionPreset", "subtitle", "content", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "media_gallery": { "fields": ["motionPreset", "subtitle", "content", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "video_embed": { "fields": ["motionPreset", "subtitle", "content", "videoEmbedUrl", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "before_after": { "fields": ["motionPreset", "subtitle", "content", "beforeImageUrl", "afterImageUrl", "beforeLabel", "afterLabel", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "instagram_feed": { "fields": ["motionPreset", "subtitle", "content", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "feature_cards": { "fields": ["motionPreset", "subtitle", "content", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "icon_list": { "fields": ["motionPreset", "subtitle", "content", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "comparison_matrix": { "fields": ["motionPreset", "subtitle", "content", "comparisonDimensionName", "comparisonOurBrandName", "comparisonCompetitorName", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "faq_accordion": { "fields": ["motionPreset", "subtitle", "content", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "contact_form": { "fields": ["motionPreset", "subtitle", "content", "formEmail", "contactPhone", "contactAddress", "contactButtonText", "formSuccessMessage", "subjectPlaceholder", "categoryPlaceholder", "messagePlaceholder", "inquiryCategories", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "store_locator": { "fields": ["motionPreset", "subtitle", "content", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "testimonials_slider": { "fields": ["motionPreset", "subtitle", "content", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "logo_cloud": { "fields": ["motionPreset", "subtitle", "content", "columnsCount", "textAlignment", "backgroundColor", "textColor", "paddingY", "items", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "cta_strip": { "fields": ["motionPreset", "subtitle", "content", "buttonText", "buttonLink", "secondaryButtonText", "secondaryButtonLink", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [] },
      "newsletter_signup": { "fields": ["motionPreset", "subtitle", "content", "buttonText", "formSuccessMessage", "newsletterCouponId", "textAlignment", "backgroundColor", "textColor", "paddingY", "customColors"], "publishRequired": ["title"], "renderer": { "capable": true }, "runtimeRequirements": [{ "field": "newsletterCouponId", "fact": "newsletterCouponId.valid" }] }
    }
  }
}
